# These credentials are shared by the local Mosquitto broker and ESP32.
MQTT_USERNAME=potato_device
MQTT_PASSWORD=change-this-password

# Backend binds this path inside Docker; override only for local Python runs.
DATABASE_PATH=./data/potato.sqlite3

# Daily statistics are grouped by local day (Vietnam = 7).
LOCAL_UTC_OFFSET_HOURS=7

# Optional Telegram alert for every new not_good result. Leave empty to disable.
# Token from @BotFather; chat id from https://api.telegram.org/bot<TOKEN>/getUpdates after messaging the bot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
